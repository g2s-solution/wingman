#!/usr/bin/env node
// usage: wingman-wait <run_id> [--timeout-ms N] [--poll-ms N] [--grace-ms N]
// Same as `wingman wait ...`: prints one line, `WINGMAN_RUN <id> <status>`, and nothing else on stdout.
// Exit: 0 done|partial, 1 other terminal status, 2 unknown run or bad usage, 3 timeout.
'use strict';
const { spawn } = require('node:child_process');
const { existsSync } = require('node:fs');
const { join } = require('node:path');

const bundle = join(__dirname, '..', 'server', 'dist', 'index.js');
if (!existsSync(bundle)) {
  process.stderr.write(`Error: ${bundle} not found; the plugin is not built\n`);
  process.exit(2);
}
const child = spawn(process.execPath, [bundle, 'wait', ...process.argv.slice(2)], {
  stdio: 'inherit',
});
// a caller that stops the waiter must stop the real process too
for (const sig of ['SIGINT', 'SIGTERM', 'SIGHUP']) process.on(sig, () => child.kill(sig));
child.on('error', (err) => {
  process.stderr.write(`Error: ${err.message}\n`);
  process.exit(2);
});
child.on('exit', (code) => process.exit(code === null ? 1 : code));
